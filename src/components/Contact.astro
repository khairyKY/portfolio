---

<section class="tight" id="contact">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="label">Contact</div>
      <h2 class="display">
        Let's <em>build</em> something<span class="dot">.</span>
      </h2>
      <p class="lead">
        Available for freelance, collaboration, and full-time opportunities.
      </p>
    </div>
    <div class="contact-grid" data-reveal>
      <a href={`mailto:${email}`} class="contact-card primary">
        <span class="contact-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </span>
        <span class="contact-label">Send an Email</span>
        <span class="contact-addr">{email}</span>
      </a>
      {cards.map(c => (
        <a href={c.href} class="contact-card" style={`--brand: ${c.brand};`} target={c.target} rel={c.target === '_blank' ? 'noopener noreferrer' : ''}>
          <span class="contact-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" set:html={c.icon}></svg>
          </span>
          <span class="contact-label">{c.label}</span>
          {c.label === 'GitHub' && <span class="contact-addr">github.com/khairyKY</span>}
          {c.label === 'LinkedIn' && <span class="contact-addr">in/khairy-shaheen</span>}
          {c.label === 'WhatsApp' && <span class="contact-addr">{phoneOld}</span>}
          {c.label === 'Phone' && (
            <span class="contact-addr contact-addr--stack">
              <span>{phoneNew}</span>
              <span class="contact-addr__alt">{phoneOld}</span>
            </span>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .contact-card {
    --brand: var(--coral);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 26px 22px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--bone);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.25s ease, background 0.25s ease;
    position: relative;
    overflow: hidden;
  }
  .contact-card:hover {
    transform: translateY(-2px);
    border-color: var(--brand);
  }
  .contact-card.primary {
    background: var(--coral);
    border-color: var(--coral);
    color: #fff;
    grid-column: 1 / -1;
  }
  .contact-card.primary:hover { background: #e25e4a; }
  .contact-icon {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--ink);
    transition: color 0.25s ease, background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .contact-card:hover .contact-icon {
    color: #fff;
    background: var(--brand);
    border-color: var(--brand);
    transform: scale(1.05);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--brand) 40%, transparent),
                0 6px 22px -4px color-mix(in srgb, var(--brand) 55%, transparent);
  }
  .contact-card.primary .contact-icon {
    border-color: rgba(255,255,255,0.35);
    color: #fff;
  }
  .contact-card.primary:hover .contact-icon {
    background: rgba(255,255,255,0.15);
    border-color: rgba(255,255,255,0.6);
    box-shadow: 0 0 14px 2px rgba(255,255,255,0.25);
  }
  .contact-label {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
    letter-spacing: -0.005em;
    transition: color 0.25s ease;
    position: relative;
    padding-bottom: 6px;
  }
  .contact-label::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--brand);
    opacity: 0.65;
    transition: width 0.25s ease, opacity 0.25s ease;
  }
  .contact-card:hover .contact-label { color: var(--brand); }
  .contact-card:hover .contact-label::after { width: 42px; opacity: 1; }
  .contact-card.primary .contact-label,
  .contact-card.primary:hover .contact-label { color: #fff; }
  .contact-card.primary .contact-label::after { background: #fff; opacity: 0.6; }
  .contact-card.primary:hover .contact-label::after { opacity: 0.9; width: 42px; }
  .contact-addr {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    word-break: break-all;
  }
  .contact-card.primary .contact-addr { color: rgba(255,255,255,0.8); }
  .contact-addr--stack { display: flex; flex-direction: column; gap: 3px; align-items: center; }
  .contact-addr__alt {
    color: var(--ink-mute);
    font-size: 11px;
    opacity: 1;
    font-family: var(--mono);
  }
  .contact-addr--stack > span { color: var(--ink-mute); }
  @media (max-width: 800px) {
    .contact-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
