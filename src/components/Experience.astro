---
const experiences = [
  {
    company: "Shaheen for Import & Export",
    role: "Business Owner & Lead Technical Operator",
    date: "Aug 2022 - Present",
    location: "Tanta, Egypt",
    bullets: [
      "Architected production Laravel 12 e-commerce platform (100+ routes, bilingual AR/EN, Paymob gateway, Google OAuth, Filament 4 admin) with 300+ commits of sole code ownership",
      "Led a 30-day rescue sprint — 100+ PRs merged, 55+ issues closed, 38 failing tests restored to green, zero-touch CI/CD via GitHub Actions",
      "Led 4-phase enterprise cloud migration of 1,343 files with Arabic text normalization and Security Quarantine; engineered zero-cost federated identity (cPanel → Google IAM → Drive RBAC, 5 permission groups)",
      "Patched 12 production-blocking vulnerabilities, restored blocked email delivery via Resend SMTP, and enforced email verification for all users",
      "Managed domain infrastructure: Cloudflare DNS/SSL, cPanel, Bitwarden, SSH deploy keys, nightly drift monitoring. Established RACI operational framework across 8 verticals for a 10+ person marketing team"
    ]
  },
  {
    company: "Optima Professional Services",
    role: "Cybersecurity Intern",
    date: "2026 - Present",
    location: "First Settlement, New Cairo",
    bullets: [
      "Conducted hands-on labs with Cisco Packet Tracer and Palo Alto firewalls to design secure network topologies and defense perimeters",
      "Performed network scanning and vulnerability assessment using Nmap; completed red team CTF exercises"
    ]
  },
  {
    company: "DEPI Round 5",
    role: "AI/ML Trainee",
    date: "Jul 2026 - Present",
    location: "Remote",
    bullets: []
  },
  {
    company: "PC Building Store",
    role: "Technical Assistant",
    date: "Jun 2019 - Aug 2022",
    location: "Tanta, Egypt",
    bullets: [
      "Assembled and configured 40+ custom PC builds for gaming, creative, and business clients",
      "Diagnosed complex hardware issues: thermal management, BIOS conflicts, driver compatibility",
      "Advised customers on cost-effective component upgrades, driving repeat business"
    ]
  }
];
---

<section class="tight" id="experience">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="label">Experience</div>
      <h2 class="display">
        Where I've <em>worked</em><span class="dot">.</span>
      </h2>
    </div>
    {experiences.map((exp, i) => (
      <div class="exp-block" data-reveal>
        <div class="exp-head">
          <span class="roman">{String.fromCharCode(0x2160 + i)}.</span>
          <div>
            <h3>{exp.company}</h3>
            <div class="meta">{exp.role} &middot; {exp.location}</div>
          </div>
          <span class="exp-date">{exp.date}</span>
        </div>
        <ul class="bullets">
          {exp.bullets.map(b => <li>{b}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .exp-block {
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .exp-block:last-child { border-bottom: none; }
  .exp-head {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    gap: 14px;
    align-items: baseline;
    margin-bottom: 16px;
  }
  .exp-head .roman {
    font-size: 18px;
    line-height: 1;
  }
  .exp-head h3 {
    font-family: var(--sans);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .exp-head .meta {
    font-size: 11px;
    margin-top: 3px;
    color: var(--ink-soft);
  }
  .exp-date {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    white-space: nowrap;
  }
  .bullets {
    list-style: none;
    padding: 0;
    margin-left: 42px;
  }
  .bullets li {
    position: relative;
    padding-left: 16px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--coral);
    opacity: 0.6;
  }
  @media (max-width: 768px) {
    .exp-head { grid-template-columns: 28px 1fr; }
    .exp-date { grid-column: 1 / -1; text-align: right; }
    .bullets { margin-left: 0; }
  }
</style>
