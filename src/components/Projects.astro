---
const projects = [
  { title: 'Shaheen E-Commerce', description: 'The live online store for my family\'s tire business. I took it over broken and rebuilt it — 300+ commits, 100+ pull requests, 55+ bugs fixed.', tags: ['Full-Stack', 'Backend', 'Infrastructure'], tech: ['Laravel 12', 'Livewire 3', 'Filament 4', 'GitHub Actions'], slug: 'shaheen-ecommerce' },
  { title: 'Sotto', description: 'A desktop app that types out what you say — fully offline, so your voice never leaves your computer.', tags: ['Full-Stack', 'AI/ML'], tech: ['Rust', 'Tauri v2', 'Parakeet ASR', 'llama.cpp'], slug: 'sotto' },
  { title: 'Sukoon', description: 'An Android app that shows my blood-sugar readings at a glance. I built it because I have Type 1 diabetes and the official app was a pain.', tags: ['Frontend', 'UI/UX'], tech: ['Kotlin', 'Jetpack Compose', 'Android'], slug: 'sukoon' },
  { title: "Kai's Flow", description: 'A personal planner I use every day — calendar, tasks, journal, and a focus timer in one place. Works even without internet.', tags: ['Full-Stack', 'Frontend'], tech: ['React 19', 'TypeScript', 'Supabase', 'FullCalendar'], slug: 'kais-flow' },
  { title: 'Customer Ordering System', description: 'A complete online-store demo — storefront, checkout, and an admin dashboard. A university team project I led.', tags: ['Full-Stack', 'Frontend', 'Backend'], tech: ['React 18', 'FastAPI', 'Tailwind', 'Playwright'], slug: 'customer-ordering-system' },
  { title: 'Scentura → Aeron', description: 'The screen designs and front-end for a perfume company\'s internal management tool — 23 screens.', tags: ['Full-Stack', 'Frontend', 'UI/UX'], tech: ['React 19', 'TypeScript', 'shadcn/ui', 'Framer Motion'], slug: 'scentura-erp' },
  { title: 'MRL Eye Classification', description: 'A drowsiness detector that watches your eyes through a webcam and sounds an alarm when you start to nod off. I trained the models.', tags: ['AI/ML'], tech: ['PyTorch', 'OpenCV', 'CUDA', 'DenseNet'], slug: 'mrl-eye-classification' },
  { title: 'Bellissimo Coffee Shop', description: 'A coffee-shop website concept with glass-like visuals and lighting that shifts with the time of day.', tags: ['Frontend', 'UI/UX'], tech: ['React 19', 'Vite', 'Tailwind', 'Framer Motion'], slug: 'bellissimo-coffee-shop' },
  { title: 'Study Guides', description: 'Free, offline study resources for computer-science students — networks, algorithms, and embedded systems.', tags: ['Frontend'], tech: ['HTML/CSS', 'JavaScript', 'Python'], slug: 'networks-study-guide' },
  { title: 'Hospital Management System', description: 'A desktop app for a clinic — appointments, billing, and separate logins for patients, doctors, and staff.', tags: ['Backend'], tech: ['Python', 'Flet', 'SQLite'], slug: 'hospital-management-system' },
  { title: 'Arduino Robotics', description: 'Three small robots — one solves a maze, one chases light, and one you drive from your phone while it senses its surroundings.', tags: ['Embedded'], tech: ['Arduino C++', 'RemoteXY', 'HC-SR04'], slug: 'arduino-robotics' }
];

const filters = ['All', 'Full-Stack', 'Frontend', 'UI/UX', 'Backend', 'AI/ML', 'Embedded'];
const filterColors = ['#ED6F5C', '#A78BFA', '#00BFFF', '#4ECDC4', '#E9B94A', '#34D399', '#ED6F5C'];
---

<section id="projects">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="label">Projects</div>
      <h2 class="display">
        What I've <em>built</em><span class="dot">.</span>
      </h2>
    </div>

    <div class="pill-bar" data-reveal id="filter-bar">
      {filters.map((f, i) => (
        <button class="pill" data-filter={f === 'All' ? 'all' : f} data-color={filterColors[i]}>
          {f}
        </button>
      ))}
    </div>

    <div class="project-grid" id="project-grid">
      {projects.map((p, i) => (
        <article class="card" data-reveal data-tags={p.tags.join(',')}${i === 0 ? ' data-featured' : ''}>
          <a href={`/project/${p.slug}`}>
            <div class="num">
              <span>{String.fromCharCode(0x2170 + i)}.</span>
              {p.tags.length > 0 && <span class="tag">{p.tags[0]}</span>}
            </div>
            <h3>{p.title}</h3>
            <p>{p.description}</p>
            <div class="card-tech">
              {p.tech.slice(0, 4).map(t => <span class="tech-pill">{t}</span>)}
            </div>
            <div class="arrow-mark">
              <svg width="14" height="14" viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" fill="none" stroke-width="1.6"/></svg>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pill-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .card a {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 14px;
  }
  .card { padding-bottom: 32px; }
  .card[data-featured] { grid-column: span 2; }
  .card[data-featured] a { display: flex; flex-direction: column; height: 100%; }
  .card[data-featured] h3 { font-size: 20px; }
  .card[data-featured] .num span:first-child { font-size: 20px; }
  .card[data-hidden] { display: none; }
  @media (max-width: 1080px) {
    .project-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .project-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const filterBar = document.getElementById('filter-bar');
  const grid = document.getElementById('project-grid');
  const cards = grid?.querySelectorAll('.card');

  filterBar?.addEventListener('click', (e) => {
    const btn = e.target.closest('.pill');
    if (!btn) return;
    filterBar.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    const filter = btn.dataset.filter;
    cards?.forEach(card => {
      if (filter === 'all') {
        card.removeAttribute('data-hidden');
      } else {
        const tags = (card.dataset.tags || '').split(',');
        card.toggleAttribute('data-hidden', !tags.includes(filter));
      }
    });
  });

  filterBar?.querySelector('.pill')?.classList.add('active');
</script>
