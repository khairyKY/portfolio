---
// GitHub-style contribution grid, coral-themed, wired to the public
// github-contributions-api (no auth). The snake slot below points at
// the SVG that Platane's `snk` GitHub Action publishes to your profile
// repo's `output` branch — until you enable that action it falls back
// to a quiet placeholder.
const GITHUB_USER = 'khairyKY';
const SNAKE_SRC = `https://raw.githubusercontent.com/${GITHUB_USER}/${GITHUB_USER}/output/github-contribution-grid-snake.svg`;
---

<section class="tight" id="activity">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="label">Activity</div>
      <h2 class="display">
        A year of <em>shipping</em><span class="dot">.</span>
      </h2>
      <p class="lead">
        Every square is a day I pushed code on GitHub. The snake, when it lands, will eat the past year one commit at a time.
      </p>
    </div>

    <div class="contrib-wrap" data-reveal>
      <div class="contrib-scroll">
        <div class="contrib-grid" id="contrib-grid" data-user={GITHUB_USER} aria-label="GitHub contribution graph, last 12 months">
          <div class="contrib-loading">Loading GitHub activity…</div>
        </div>
      </div>

      <div class="contrib-snake" id="contrib-snake">
        <img
          src={SNAKE_SRC}
          alt="Snake animation traversing the contribution grid"
          onerror="this.style.display='none'; document.getElementById('snake-fallback').hidden = false;"
        />
        <div id="snake-fallback" class="snake-fallback" hidden>
          <span class="mono">snake pending — awaiting <a href="https://github.com/Platane/snk" target="_blank" rel="noopener">Platane/snk</a> action on <code>khairyKY/khairyKY</code></span>
        </div>
      </div>

      <div class="contrib-legend">
        <span class="mono lo">Less</span>
        <span class="lg lg-0"></span>
        <span class="lg lg-1"></span>
        <span class="lg lg-2"></span>
        <span class="lg lg-3"></span>
        <span class="lg lg-4"></span>
        <span class="mono lo">More</span>
      </div>
    </div>
  </div>
</section>

<style>
  .contrib-wrap {
    background: var(--bone);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px;
  }
  .contrib-scroll {
    overflow-x: auto;
    padding-bottom: 6px;
  }
  .contrib-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 1fr);
    gap: 3px;
    min-width: 760px;
    max-width: 100%;
  }
  .contrib-loading {
    grid-row: 1 / -1;
    grid-column: 1 / -1;
    color: var(--ink-mute);
    font-family: var(--mono);
    font-size: 12px;
    padding: 28px 8px;
  }
  .contrib-cell {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 2px;
    background: color-mix(in srgb, var(--line) 60%, transparent);
    transition: transform 0.15s ease;
  }
  .contrib-cell:hover { transform: scale(1.35); }
  .contrib-cell.l1 { background: color-mix(in srgb, var(--coral) 22%, var(--bone)); }
  .contrib-cell.l2 { background: color-mix(in srgb, var(--coral) 45%, var(--bone)); }
  .contrib-cell.l3 { background: color-mix(in srgb, var(--coral) 72%, var(--bone)); }
  .contrib-cell.l4 { background: var(--coral); }
  .contrib-cell.spacer { visibility: hidden; }

  .contrib-snake {
    margin-top: 22px;
    min-height: 44px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .contrib-snake img { max-width: 100%; height: auto; }
  .snake-fallback {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-mute);
    padding: 12px 16px;
    border: 1px dashed var(--line);
    border-radius: 8px;
    text-align: center;
  }
  .snake-fallback a { color: var(--coral); }
  .snake-fallback code {
    background: color-mix(in srgb, var(--coral) 12%, var(--bone));
    padding: 1px 5px;
    border-radius: 3px;
  }

  .contrib-legend {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 5px;
    margin-top: 20px;
    font-size: 11px;
  }
  .contrib-legend .lo { color: var(--ink-mute); }
  .contrib-legend .lg {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    display: inline-block;
  }
  .contrib-legend .lg-0 { background: color-mix(in srgb, var(--line) 60%, transparent); }
  .contrib-legend .lg-1 { background: color-mix(in srgb, var(--coral) 22%, var(--bone)); }
  .contrib-legend .lg-2 { background: color-mix(in srgb, var(--coral) 45%, var(--bone)); }
  .contrib-legend .lg-3 { background: color-mix(in srgb, var(--coral) 72%, var(--bone)); }
  .contrib-legend .lg-4 { background: var(--coral); }
</style>

<script>
  const grid = document.getElementById('contrib-grid');
  if (grid) {
    const user = grid.dataset.user;
    fetch(`https://github-contributions-api.jogruber.de/v4/${user}?y=last`)
      .then(r => r.ok ? r.json() : Promise.reject(r.status))
      .then(data => {
        const days = Array.isArray(data.contributions) ? data.contributions : [];
        if (!days.length) throw new Error('empty');
        grid.innerHTML = '';
        // Pad start so weekdays line up (Sunday = row 1).
        const firstWeekday = new Date(days[0].date).getDay();
        for (let i = 0; i < firstWeekday; i++) {
          const s = document.createElement('span');
          s.className = 'contrib-cell spacer';
          grid.appendChild(s);
        }
        for (const d of days) {
          const cell = document.createElement('span');
          cell.className = 'contrib-cell l' + (d.level ?? 0);
          cell.title = `${d.count} contribution${d.count === 1 ? '' : 's'} on ${d.date}`;
          grid.appendChild(cell);
        }
      })
      .catch(() => {
        grid.innerHTML = '<div class="contrib-loading">GitHub activity temporarily unavailable.</div>';
      });
  }
</script>
