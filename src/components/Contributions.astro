---
// GitHub contribution snake, published by the Platane/snk action on
// khairyKY/khairyKY to the `output` branch. Two theme variants — the site
// shows the one matching the active theme (dark by default).
const GITHUB_USER = 'khairyKY';
const SNAKE_DARK = `https://raw.githubusercontent.com/${GITHUB_USER}/${GITHUB_USER}/output/github-snake.svg`;
const SNAKE_LIGHT = `https://raw.githubusercontent.com/${GITHUB_USER}/${GITHUB_USER}/output/github-snake-light.svg`;
---

<section class="tight" id="activity">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="label">Activity</div>
      <h2 class="display">
        A year of <em>shipping</em><span class="dot">.</span>
      </h2>
      <p class="lead">
        Every square is a day I pushed code on GitHub. The snake eats the past year, one commit at a time.
      </p>
    </div>

    <div class="contrib-wrap" data-reveal>
      <div class="contrib-snake">
        <img class="snake snake-dark" src={SNAKE_DARK} alt="Snake animation traversing my GitHub contribution grid" loading="lazy"
             onerror="this.style.display='none'; document.getElementById('snake-fallback').hidden = false;" />
        <img class="snake snake-light" src={SNAKE_LIGHT} alt="Snake animation traversing my GitHub contribution grid" loading="lazy" />
        <div id="snake-fallback" class="snake-fallback" hidden>
          <span class="mono">GitHub activity is loading — or take a look at <a href="https://github.com/khairyKY" target="_blank" rel="noopener">github.com/khairyKY</a></span>
        </div>
      </div>

      <div class="contrib-legend">
        <span class="mono lo">Less</span>
        <span class="lg lg-1"></span>
        <span class="lg lg-2"></span>
        <span class="lg lg-3"></span>
        <span class="lg lg-4"></span>
        <span class="mono lo">More</span>
      </div>
    </div>
  </div>
</section>

<style>
  .contrib-wrap {
    background: var(--bone);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px;
  }
  .contrib-snake {
    display: flex;
    justify-content: center;
    align-items: center;
    overflow-x: auto;
  }
  .contrib-snake .snake {
    max-width: 100%;
    height: auto;
    min-width: 640px;
  }
  /* Theme swap — default (dark) shows the dark snake. */
  .contrib-snake .snake-light { display: none; }
  .contrib-snake .snake-dark { display: block; }
  :root[data-theme="light"] .contrib-snake .snake-dark { display: none; }
  :root[data-theme="light"] .contrib-snake .snake-light { display: block; }

  .snake-fallback {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-mute);
    padding: 24px 16px;
    text-align: center;
  }
  .snake-fallback a { color: var(--coral); }

  .contrib-legend {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 5px;
    margin-top: 18px;
    font-size: 11px;
  }
  .contrib-legend .lo { color: var(--ink-mute); }
  .contrib-legend .lg { width: 11px; height: 11px; border-radius: 2px; display: inline-block; }
  .contrib-legend .lg-1 { background: color-mix(in srgb, var(--coral) 22%, var(--bone)); }
  .contrib-legend .lg-2 { background: color-mix(in srgb, var(--coral) 45%, var(--bone)); }
  .contrib-legend .lg-3 { background: color-mix(in srgb, var(--coral) 72%, var(--bone)); }
  .contrib-legend .lg-4 { background: var(--coral); }
</style>
