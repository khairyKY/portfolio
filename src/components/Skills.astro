---
// Stack — honest framing. Each row lists tech I've shipped with,
// annotated with the concrete project it's from.
// The subtitle names the AI-first practice openly.
const stack = [
  {
    label: 'Languages I ship in',
    items: [
      { name: 'TypeScript / JavaScript', on: "Kai's Flow, portfolio, Scentura" },
      { name: 'PHP', on: 'shaheentire.com (Laravel 12)' },
      { name: 'Rust', on: 'Sotto' },
      { name: 'Python', on: 'MRL Eye, Customer Ordering' },
      { name: 'Kotlin', on: 'Sukoon (Android)' },
      { name: 'Swift', on: 'ErgoX-UI (team contribution)' },
      { name: 'C / C++', on: 'Arduino robotics, DS coursework' },
      { name: 'SQL', on: 'shaheentire.com, Customer Ordering' }
    ]
  },
  {
    label: 'Frameworks & runtimes',
    items: [
      { name: 'Laravel 12 (Livewire, Filament)', on: 'shaheentire.com' },
      { name: 'React 19 + Vite', on: "Kai's Flow, Scentura, Bellissimo" },
      { name: 'FastAPI', on: 'Customer Ordering' },
      { name: 'Tauri v2', on: 'Sotto' },
      { name: 'Jetpack Compose', on: 'Sukoon' },
      { name: 'Astro', on: 'this portfolio' }
    ]
  },
  {
    label: 'Data, infra & deploys',
    items: [
      { name: 'PostgreSQL / SQLite / Supabase', on: "shaheentire, Kai's Flow" },
      { name: 'Docker Compose', on: 'Customer Ordering' },
      { name: 'GitHub Actions CI/CD', on: 'shaheentire (zero-touch deploys)' },
      { name: 'Cloudflare (DNS/SSL, Workers)', on: "shaheentire, Kai's Flow" },
      { name: 'cPanel + SSH', on: 'shaheentire (GoDaddy)' }
    ]
  },
  {
    label: 'AI / ML — on-device',
    items: [
      { name: 'ONNX Runtime + Vulkan', on: 'Sotto (70× CPU speedup)' },
      { name: 'llama.cpp', on: 'Sotto (Qwen 2.5 local)' },
      { name: 'PyTorch (ViT, DenseNet, CUDA)', on: 'MRL Eye (>96% val acc)' },
      { name: 'HuggingFace / Gemini API', on: 'Customer Ordering, chatbot' }
    ]
  },
  {
    label: 'Design & tooling',
    items: [
      { name: 'Figma (Variables, Motion, tokens)', on: 'e& internship design system' },
      { name: 'Git & GitHub', on: 'daily driver' },
      { name: 'Claude Code (AI-first workflow)', on: 'every project on this page' }
    ]
  }
];
---

<section class="tight" id="skills">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="label">Stack</div>
      <h2 class="display">
        Shipped <em>with</em><span class="dot">.</span>
      </h2>
      <p class="lead">
        Not "expert in everything" — <em>shipped with everything</em>. I develop AI-first: I use AI coding agents heavily, review every diff myself, and deepen the fundamentals underneath as I go. Each item below links back to a real project on this site.
      </p>
    </div>
    <div class="stack-featured" data-reveal>
      <div class="stack-featured__badge">How I work</div>
      <div class="stack-featured__body">
        <h3 class="stack-featured__title">AI-first, human-reviewed<span class="dot">.</span></h3>
        <p class="stack-featured__lead">
          <strong>Claude Code is my daily driver.</strong> I plan out loud, delegate the scaffolding, and read every diff before it ships. I use AI to accelerate the parts I already understand — not to paper over the parts I don't. Every project on this page shipped this way, and I'm faster because of it.
        </p>
        <div class="stack-featured__chips">
          <span class="chip chip--hero">Claude Code</span>
          <span class="chip">Claude Design</span>
          <span class="chip">Claude on the web</span>
          <span class="chip">MCP tooling</span>
          <span class="chip">Gemini API</span>
          <span class="chip">OpenCode</span>
        </div>
      </div>
    </div>
    <div class="stack-grid" data-reveal>
      {stack.map(group => (
        <div class="stack-card">
          <div class="label">{group.label}</div>
          <ul class="stack-list">
            {group.items.map(it => (
              <li>
                <span class="stack-name">{it.name}</span>
                <span class="stack-on">{it.on}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-featured {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 28px;
    align-items: start;
    padding: 28px 32px;
    margin-bottom: 26px;
    border-radius: 18px;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--coral) 12%, var(--bone)) 0%,
      var(--bone) 65%);
    border: 1px solid color-mix(in srgb, var(--coral) 30%, var(--line));
    box-shadow: 0 12px 40px -20px color-mix(in srgb, var(--coral) 40%, transparent);
    overflow: hidden;
  }
  .stack-featured::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 4px; height: 100%;
    background: var(--coral);
  }
  .stack-featured__badge {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--coral);
    padding: 8px 14px;
    background: color-mix(in srgb, var(--coral) 15%, var(--bone));
    border: 1px solid color-mix(in srgb, var(--coral) 40%, transparent);
    border-radius: 999px;
    white-space: nowrap;
    align-self: flex-start;
  }
  .stack-featured__title {
    font-family: var(--sans);
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .stack-featured__title .dot { color: var(--coral); }
  .stack-featured__lead {
    font-family: var(--body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 18px;
    max-width: 68ch;
  }
  .stack-featured__lead strong { color: var(--ink); font-weight: 700; }
  .stack-featured__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--bone);
    border: 1px solid var(--line);
    color: var(--ink-soft);
    letter-spacing: 0.01em;
  }
  .chip--hero {
    background: var(--coral);
    border-color: var(--coral);
    color: #fff;
  }
  @media (max-width: 640px) {
    .stack-featured { grid-template-columns: 1fr; padding: 22px; gap: 16px; }
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .stack-card {
    padding: 20px 22px;
    background: var(--bone);
    border: 1px solid var(--line);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .stack-card .label {
    margin-bottom: 0;
    font-size: 11px;
    color: var(--coral);
  }
  .stack-card .label::before { width: 14px; }
  .stack-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stack-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--line) 70%, transparent);
    font-size: 13px;
    line-height: 1.4;
  }
  .stack-list li:last-child { border-bottom: none; }
  .stack-name {
    font-family: var(--sans);
    font-weight: 600;
    color: var(--ink);
  }
  .stack-on {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 55%;
  }
  @media (max-width: 768px) {
    .stack-grid { grid-template-columns: 1fr; }
    .stack-list li { flex-direction: column; align-items: flex-start; gap: 2px; }
    .stack-on { max-width: 100%; text-align: left; white-space: normal; }
  }
</style>
