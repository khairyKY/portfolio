---
const skillCategories = [
  { label: 'Languages', items: 'Rust, Python, JavaScript/TypeScript, PHP, Kotlin, C++, C, Swift, SQL, Arduino C++, LaTeX' },
  { label: 'Backend', items: 'FastAPI, Laravel 12 (Livewire 3, Filament 4), Express 5' },
  { label: 'Frontend & Native', items: 'React 19, Tailwind CSS v3/v4, Framer Motion, Tauri v2, SwiftUI, Jetpack Compose, Flutter' },
  { label: 'Databases', items: 'PostgreSQL, SQLite, MongoDB, Supabase, SQLAlchemy ORM, Eloquent ORM' },
  { label: 'AI/ML & On-Device', items: 'PyTorch (DenseNet, ViT, CUDA), ONNX Runtime, whisper.cpp, llama.cpp, HuggingFace, Google Gemini, OpenCV' },
  { label: 'DevOps & Infra', items: 'Docker Compose, Git, GitHub Actions CI/CD, Cloudflare DNS/SSL, cPanel, SSH' },
  { label: 'Embedded', items: 'ESP32-CAM, Arduino (RemoteXY, NewPing, DHT11, MQ, LDR, HC-SR04), NMEA 0183' },
  { label: 'Security & Networking', items: 'Cisco Packet Tracer, Palo Alto, Nmap, RBAC, JWT/OAuth, PII Redaction' },
  { label: 'Design & Ops', items: 'Figma, Photoshop, Illustrator, Canva, RACI, Obsidian' }
];
---

<section class="tight" id="skills">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="label">Skills</div>
      <h2 class="display">
        Tools & <em>expertise</em><span class="dot">.</span>
      </h2>
    </div>
    <div class="skills-grid" data-reveal>
      {skillCategories.map(s => (
        <div class="skill-card">
          <div class="label">{s.label}</div>
          <span class="skill-items">{s.items}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .skill-card {
    padding: 16px 18px;
    background: var(--bone);
    border: 1px solid var(--line);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .skill-card .label {
    margin-bottom: 0;
    font-size: 10px;
    color: var(--coral);
  }
  .skill-card .label::before {
    width: 14px;
  }
  .skill-items {
    font-family: var(--body);
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  @media (max-width: 768px) {
    .skills-grid { grid-template-columns: 1fr; }
  }
</style>
