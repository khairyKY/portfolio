---
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="label" data-reveal>Portfolio</div>
        <h1 class="display" data-reveal>
          I ship the things I <em>need</em><span class="dot">.</span>
        </h1>
        <p class="lead" data-reveal>
          Sotto, Sukoon, Kai's Flow, shaheentire.com — each started as "I want this and it doesn't exist." I build the thing, then ship it.
        </p>
        <div class="hero-actions" data-reveal>
          <a href="#projects" class="btn btn-primary">
            View Projects
            <span class="arrow"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" fill="none" stroke-width="1.6"/></svg></span>
          </a>
          <a href="#contact" class="btn btn-ghost">Get in Touch</a>
        </div>
        <div class="hero-stats" data-reveal>
          <div class="stat">
            <span class="stat-ring coral solid">300+</span>
            <span class="stat-label"><b>Commits</b>On production</span>
          </div>
          <div class="stat">
            <span class="stat-ring">12</span>
            <span class="stat-label"><b>Projects</b>Built</span>
          </div>
        </div>
      </div>
      <div class="hero-art" data-reveal="right">
        <div class="profile-scroll" id="profile-scroll">
          <div class="quote-bubble" id="quote-bubble" aria-hidden="true">
            <span id="quote-text"></span><span class="quote-cursor">|</span>
          </div>
          <div class="profile-ring">
            <img src="/images/profile.jpg" alt="Khairy Shaheen" class="profile-img" id="profile-img" />
          </div>
        </div>
        <div class="hero-index">
          <span><span class="n">01</span> Full-Stack</span>
          <span><span class="n">02</span> AI / ML</span>
          <span><span class="n">03</span> Embedded</span>
          <span class="on"><span class="n">04</span> Infrastructure</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 0;
    min-height: calc(100vh - 140px);
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    width: 100%;
    padding: 80px 0;
  }
  .hero-copy { display: flex; flex-direction: column; }
  .hero-copy .label { margin-bottom: 28px; }
  .hero-copy .lead { margin-bottom: 30px; max-width: 44ch; font-size: 17px; }
  .hero h1 {
    font-size: clamp(44px, 5vw, 78px);
    line-height: 1.0;
    margin-bottom: 28px;
  }
  .hero-actions { display: inline-flex; align-items: center; gap: 14px; margin-bottom: 38px; }
  .hero-actions .arrow { width: 16px; height: 16px; display: inline-flex; }
  .hero-actions .arrow svg { width: 100%; height: 100%; }
  .hero-stats { display: flex; align-items: center; gap: 22px; flex-wrap: nowrap; }
  .stat { display: inline-flex; align-items: center; gap: 9px; white-space: nowrap; }
  .stat-label {
    font-family: var(--sans);
    font-size: 11px;
    line-height: 1.25;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .stat-label b { display: block; font-weight: 700; color: var(--ink); font-size: 12px; }

  .hero-art { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; }
  .profile-scroll { position: relative; width: 100%; display: flex; justify-content: center; }
  .profile-ring {
    width: min(260px, 20vw);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 2px var(--line-soft), 0 0 40px 8px rgba(239, 231, 210, 0.18), 0 20px 60px -20px rgba(0,0,0,0.4);
    transition: opacity 0.5s ease, transform 0.5s ease, box-shadow 0.5s ease;
  }
  .profile-ring img { width: 100%; height: 100%; display: block; object-fit: cover; }
  body.profile-in-nav .profile-ring { opacity: 0; transform: scale(0.85); }

  /* Speech bubble */
  .quote-bubble {
    position: absolute;
    top: -14px;
    right: calc(50% - 180px);
    max-width: 240px;
    min-width: 160px;
    background: var(--bone);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 10px 14px;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--ink);
    box-shadow: 0 10px 30px -12px rgba(0,0,0,0.25);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
    z-index: 3;
  }
  .quote-bubble.on { opacity: 1; transform: translateY(0); }
  .quote-bubble::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 22px;
    width: 14px;
    height: 14px;
    background: var(--bone);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transform: rotate(45deg);
  }
  .quote-cursor {
    display: inline-block;
    width: 6px;
    color: var(--coral);
    animation: blink 1s steps(2) infinite;
    margin-left: 1px;
  }
  @keyframes blink { 50% { opacity: 0; } }
  body.profile-in-nav .quote-bubble { opacity: 0; }

  .hero-index {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    text-transform: uppercase;
    background: var(--bone);
    padding: 18px 22px;
    border: 1px solid var(--line-soft);
    border-radius: 12px;
  }
  .hero-index span { display: block; line-height: 2; }
  .hero-index .n { color: var(--coral); margin-right: 8px; font-weight: 700; }
  .hero-index .on { color: var(--ink); font-weight: 700; }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; padding: 60px 0; }
    .hero-art { display: none; }
    .hero { min-height: auto; }
  }
  @media (max-width: 480px) {
    .hero-stats { flex-wrap: wrap; gap: 14px; }
  }
</style>

<script>
  // Typewriter quote bubble
  const quotes = [
    "regex? easy. trivial, actually.",
    "CSS is Turing complete because I said so",
    "javascript was designed on purpose",
    "we don't need types, we have vibes",
    "monorepos solve every problem",
    "the algorithm just needs more RAM",
    "just add more Redis",
    "there are only two hard things in CS: caching, and off-by-one errors, and naming",
    "you can absolutely parse HTML with regex",
    "AI wrote this. AI reviewed it. AI is on vacation now.",
    "yes it's O(n²), no I won't fix it",
    "the true bottleneck is the developer",
    "hover states are a rich man's game"
  ];
  const bubble = document.getElementById('quote-bubble');
  const target = document.getElementById('quote-text');
  if (bubble && target) {
    let qi = Math.floor(Math.random() * quotes.length);
    let typing = false;
    async function typeNext() {
      if (typing) return;
      typing = true;
      const text = quotes[qi];
      target.textContent = '';
      bubble.classList.add('on');
      for (let i = 0; i < text.length; i++) {
        target.textContent += text[i];
        await new Promise(r => setTimeout(r, 45 + Math.random() * 45));
      }
      await new Promise(r => setTimeout(r, 3200));
      // erase
      for (let i = text.length; i > 0; i--) {
        target.textContent = text.slice(0, i - 1);
        await new Promise(r => setTimeout(r, 22));
      }
      await new Promise(r => setTimeout(r, 400));
      qi = (qi + 1) % quotes.length;
      typing = false;
      typeNext();
    }
    // Kick off after a beat so the reveal animation settles
    setTimeout(typeNext, 900);
  }
</script>
